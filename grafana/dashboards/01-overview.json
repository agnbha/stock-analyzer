    {
      "id": 20,
      "title": "Account value over time",
      "type": "timeseries",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "stock-analyzer-sqlite"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "stock-analyzer-sqlite"
          },
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT CAST(strftime('%s', session_date) AS INTEGER) AS time,\n       COALESCE(recorded_cash, 0) + COALESCE(realized_net_cumulative, 0) AS \"Account value\",\n       recorded_cash                                                     AS \"Recorded cash\",\n       realized_net_cumulative                                           AS \"Cumulative net P&L\"\nFROM v_equity_curve\nORDER BY session_date",
          "queryText": "SELECT CAST(strftime('%s', session_date) AS INTEGER) AS time,\n       COALESCE(recorded_cash, 0) + COALESCE(realized_net_cumulative, 0) AS \"Account value\",\n       recorded_cash                                                     AS \"Recorded cash\",\n       realized_net_cumulative                                           AS \"Cumulative net P&L\"\nFROM v_equity_curve\nORDER BY session_date",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR",
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "description": "Recorded cash is what you told the journal the account holds; cumulative net P&L is derived from closed lots. Account value adds the two, so it is only as accurate as the last balance you recorded."
    },
