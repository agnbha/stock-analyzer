      "description": "Quantity × price summed over every recorded fill, buys and sells alike.\n\n- **Bet amount** — the rupee value that changed hands on a fill. Turnover, not money at risk: buying and later selling the same share counts twice."
    },
    {
      "id": 12,
      "title": "Net gain / loss",
      "type": "stat",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "stock-analyzer-sqlite"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "stock-analyzer-sqlite"
          },
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT COALESCE(SUM(net_pnl), 0) AS value FROM v_daily_pnl",
          "queryText": "SELECT COALESCE(SUM(net_pnl), 0) AS value FROM v_daily_pnl",
          "timeColumns": []
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 2,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "description": "Realised profit after costs, summed over every session.\n\n- **Gross P&L** — profit from price movement alone.\n- **Net P&L** — gross minus brokerage, taxes and fees. This is what actually reached the account.\n\nClosed lots only. Open positions are not counted."
    },
