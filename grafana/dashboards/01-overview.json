          "rawQueryText": "SELECT session_date AS \"Date\",\n       symbol       AS \"Symbol\",\n       side         AS \"Side\",\n       product      AS \"Product\",\n       quantity     AS \"Qty\",\n       price        AS \"Price\",\n       bet_amount   AS \"Bet amount\",\n       charges      AS \"Charges\"\nFROM v_bet\nORDER BY bet_amount DESC\nLIMIT 500",
          "queryText": "SELECT session_date AS \"Date\",\n       symbol       AS \"Symbol\",\n       side         AS \"Side\",\n       product      AS \"Product\",\n       quantity     AS \"Qty\",\n       price        AS \"Price\",\n       bet_amount   AS \"Bet amount\",\n       charges      AS \"Charges\"\nFROM v_bet\nORDER BY bet_amount DESC\nLIMIT 500",
