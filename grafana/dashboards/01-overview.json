          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT COALESCE(recorded_cash, 0) + COALESCE(realized_net_cumulative, 0) AS value\nFROM v_equity_curve ORDER BY session_date DESC LIMIT 1",
