    {
      "id": 20,
      "title": "Account value over time",
      "type": "timeseries",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "stock-analyzer-sqlite"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "stock-analyzer-sqlite"
          },
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT CAST(strftime('%s', session_date) AS INTEGER) AS time,\n       account_value           AS \"Account value\",\n       broker_cash             AS \"Cash\",\n       broker_holdings         AS \"Holdings\",\n       realized_net_cumulative AS \"Cumulative net P&L\"\nFROM v_account_equity\nORDER BY session_date",
          "queryText": "SELECT CAST(strftime('%s', session_date) AS INTEGER) AS time,\n       account_value           AS \"Account value\",\n       broker_cash             AS \"Cash\",\n       broker_holdings         AS \"Holdings\",\n       realized_net_cumulative AS \"Cumulative net P&L\"\nFROM v_account_equity\nORDER BY session_date",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "description": "Two different claims, plotted together on purpose.\n\n- **Account value** — what the broker reported that evening: cash plus holdings at market.\n- **Cumulative net P&L** — derived from closed lots. Ignores deposits, withdrawals, and anything traded outside this journal.\n\nBefore the first broker reading, the value line falls back to the derived one."
    },
