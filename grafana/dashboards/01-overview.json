          "rawQueryText": "SELECT CAST(strftime('%s', session_date) AS INTEGER) AS time,\n       gross_pnl AS \"Gross P&L\",\n       net_pnl   AS \"Net P&L\"\nFROM v_daily_pnl\nORDER BY session_date",
          "queryText": "SELECT CAST(strftime('%s', session_date) AS INTEGER) AS time,\n       gross_pnl AS \"Gross P&L\",\n       net_pnl   AS \"Net P&L\"\nFROM v_daily_pnl\nORDER BY session_date",
          "timeColumns": [
            "time"
