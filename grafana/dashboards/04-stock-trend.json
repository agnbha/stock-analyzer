{
  "uid": "stockanalyzer-trend",
  "title": "Stock Trend",
  "description": "Day-to-day price action with the indicators that describe it, and how much of the market is moving the same way.",
  "tags": [
    "stock-analyzer",
    "trend"
  ],
  "timezone": "Asia/Kolkata",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-3M",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "symbol",
        "label": "Symbol",
        "type": "query",
        "datasource": {
          "type": "frser-sqlite-datasource",
          "uid": "stock-analyzer-sqlite"
        },
        "query": "SELECT symbol FROM instrument ORDER BY symbol",
        "definition": "SELECT symbol FROM instrument ORDER BY symbol",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": false,
