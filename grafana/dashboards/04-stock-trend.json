        "datasource": {
          "type": "frser-sqlite-datasource",
          "uid": "stock-analyzer-sqlite"
        },
        "query": "SELECT DISTINCT detector_version FROM gain_opportunity ORDER BY detector_version",
        "definition": "SELECT DISTINCT detector_version FROM gain_opportunity ORDER BY detector_version",
        "refresh": 1,
