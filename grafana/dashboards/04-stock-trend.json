          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT ROUND(beta, 2) AS \"Beta\" FROM v_symbol_beta WHERE symbol = '$symbol'",
          "queryText": "SELECT ROUND(beta, 2) AS \"Beta\" FROM v_symbol_beta WHERE symbol = '$symbol'",
          "timeColumns": []
        }
      ],
      "options": {
        "reduceOptions": {
