    {
      "id": 10,
      "type": "candlestick",
      "title": "$symbol - daily candles, moving averages, and the best window each day",
      "description": "Daily candles with their moving averages, and the best window the detector found each session.\n\n- **SMA 5 / 20 / 50** — simple moving averages of the last 5, 20 and 50 daily closes. A smooth line showing recent trend direction; the shorter the window, the faster it turns.\n- **Best entry / exit** (green, red) — entry and exit of that session's single best window.\n\nEach average appears only once its window is full, so the 50-day line starts 50 sessions in.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "stock-analyzer-sqlite"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "stock-analyzer-sqlite"
          },
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT t.ts_epoch AS time,\n       t.open, t.high, t.low, t.close,\n       t.sma5           AS \"SMA 5\",\n       t.sma20          AS \"SMA 20\",\n       t.sma50          AS \"SMA 50\",\n       o.entry_price    AS \"Best entry\",\n       o.exit_price     AS \"Best exit\"\nFROM v_symbol_trend t\nLEFT JOIN v_opportunity_markers o\n       ON o.symbol = t.symbol AND o.session_date = t.session_date\n      AND o.detector_version = '$detector' AND o.rank = 1\nWHERE t.symbol = '$symbol'\nORDER BY t.ts_epoch",
          "queryText": "SELECT t.ts_epoch AS time,\n       t.open, t.high, t.low, t.close,\n       t.sma5           AS \"SMA 5\",\n       t.sma20          AS \"SMA 20\",\n       t.sma50          AS \"SMA 50\",\n       o.entry_price    AS \"Best entry\",\n       o.exit_price     AS \"Best exit\"\nFROM v_symbol_trend t\nLEFT JOIN v_opportunity_markers o\n       ON o.symbol = t.symbol AND o.session_date = t.session_date\n      AND o.detector_version = '$detector' AND o.rank = 1\nWHERE t.symbol = '$symbol'\nORDER BY t.ts_epoch",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "options": {
        "mode": "candles",
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "colors": {
          "down": "red",
          "up": "green",
          "flat": "gray"
        },
        "includeAllFields": true,
        "tooltip": {
