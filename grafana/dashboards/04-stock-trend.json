  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Trend - $symbol",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "stock-analyzer-sqlite"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "stock-analyzer-sqlite"
          },
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT trend_score AS \"Trend\"\nFROM v_symbol_trend\nWHERE symbol = '$symbol' AND trend_score IS NOT NULL\nORDER BY session_date DESC LIMIT 1",
          "queryText": "SELECT trend_score AS \"Trend\"\nFROM v_symbol_trend\nWHERE symbol = '$symbol' AND trend_score IS NOT NULL\nORDER BY session_date DESC LIMIT 1",
          "timeColumns": []
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Bearish",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Neutral",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "Bullish",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Where price sits against its own averages. A description, not a forecast.\n\n- **Bullish** — close and the 5-day average both above the 20-day average.\n- **Bearish** — both below.\n- **Neutral** — anything else."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "RSI (14) - $symbol",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "stock-analyzer-sqlite"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "stock-analyzer-sqlite"
          },
          "refId": "A",
          "queryType": "table",
          "rawQueryText": "SELECT ROUND(rsi14, 1) AS \"RSI(14)\"\nFROM v_symbol_trend\nWHERE symbol = '$symbol' AND rsi14 IS NOT NULL\nORDER BY session_date DESC LIMIT 1",
          "queryText": "SELECT ROUND(rsi14, 1) AS \"RSI(14)\"\nFROM v_symbol_trend\nWHERE symbol = '$symbol' AND rsi14 IS NOT NULL\nORDER BY session_date DESC LIMIT 1",
          "timeColumns": []
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 30
              },
              {
                "color": "orange",
                "value": 70
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Momentum on a 0–100 scale, over the last 14 sessions.\n\n- **RSI** — how hard price has been pushed one way. Above 70 is conventionally overbought (ran up fast, may pause); below 30 oversold (dropped fast, may bounce).\n\nSimple-average (Cutler) RSI, not Wilder's smoothing — a SQL view cannot express the recursion."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Beta - $symbol",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "stock-analyzer-sqlite"
