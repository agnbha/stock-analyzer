            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Net per use"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyINR"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
